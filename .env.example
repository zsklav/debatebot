GROQ_API_KEY=your_groq_api_key_here

# Optional: shared model for all roles. Must be available through Groq.
DEBATEBOT_MODEL=openai/gpt-oss-20b
# Optional per-role overrides (uncomment and use a compatible model ID).
# DEBATEBOT_DEBATE_MODEL=openai/gpt-oss-20b
# DEBATEBOT_FINDHOLE_MODEL=openai/gpt-oss-20b
# DEBATEBOT_SCORER_MODEL=openai/gpt-oss-20b
# DEBATEBOT_JUDGE_MODEL=openai/gpt-oss-20b
# DEBATEBOT_EVIDENCE_MODEL=openai/gpt-oss-20b
# DEBATEBOT_RESEARCH_MODEL=openai/gpt-oss-20b
# Optional API local retrieval paths (defaults are relative to the repository).
# DEBATEBOT_EVIDENCE_STORAGE=C:/path/to/.data/qdrant
# DEBATEBOT_EMBEDDING_CACHE=C:/path/to/.data/models

# Optional persistent application storage. Leave unset for volatile demo mode.
# DATABASE_URL=postgresql://user:password@127.0.0.1:55432/debatebot

# Authentication is required unless explicitly disabled for local demos/tests.
DEBATEBOT_AUTH_REQUIRED=1
# For an HTTPS deployment set the exact public origin; cookies default to Secure.
# DEBATEBOT_PUBLIC_ORIGIN=https://your-app.example
# DEBATEBOT_COOKIE_SECURE=1

# Web mode: auto uses Tavily when a key exists; otherwise best-effort DDGS/Bing.
DEBATEBOT_WEB_PROVIDER=auto
# TAVILY_API_KEY=your_tavily_key_here
